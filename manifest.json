{
  "manifest_version": 3,
  "name": "Block Sites",
  "version": "0.0.2",
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "64": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ]
}
